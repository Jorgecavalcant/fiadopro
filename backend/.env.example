# =================================================================
# FIADO PRO Backend — Environment Variables
# =================================================================

# Server
NODE_ENV=production
PORT=4000

# Database PostgreSQL
DB_HOST=fiado-pro-db
DB_PORT=5432
DB_NAME=fiado_pro
DB_USER=fiado_app
# Runtime: o Node lê DB_APP_PASSWORD || DB_PASSWORD (ver config/database.ts).
DB_APP_PASSWORD=
# Senha do fiado_user (migrations/ops) e fallback local/compose.
DB_PASSWORD=

# OpenRouter (IA — toda chamada passa pelo backend, nunca no bundle do frontend)
OPENROUTER_API_KEY=

# Admin bootstrap (frente CORE) — usado também pelo fallback provisório de
# requireAdmin enquanto users.role (migration 002) não estiver disponível.
ADMIN_EMAIL=
# Apenas este e-mail recebe role=admin. Cadastros novos nascem role=user.

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://fiadopro.jcplanejamento.com.br,http://localhost:3000

# Logs
LOG_LEVEL=info

# Asaas (Billing) — staging roda sem essas variaveis (pagamentos ficam desabilitados)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_PRO_PRICE=30.00

# Confirmação de e-mail no cadastro. Vazio ou false mantém o cadastro atual.
REQUIRE_EMAIL_CONFIRMATION=
