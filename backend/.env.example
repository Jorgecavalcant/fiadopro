# =================================================================
# FIADO PRO Backend — Environment Variables
# =================================================================

# Server
NODE_ENV=production
PORT=4000

# Database PostgreSQL
DB_HOST=fiado-pro-db
DB_PORT=5432
DB_NAME=fiado_pro
DB_USER=fiado_user
DB_PASSWORD=change_me_in_production

# Google Gemini API (SECURE - server-side only)
GOOGLE_API_KEY=your_api_key_here
GOOGLE_PROJECT_ID=your_project_id

# JWT Auth
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://fiadopro.jcplanejamento.com.br,http://localhost:3000

# Logs
LOG_LEVEL=info
