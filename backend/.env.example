# =================================================================
# FIADO PRO Backend — Environment Variables
# =================================================================

# Server
NODE_ENV=production
PORT=4000

# Database PostgreSQL
DB_HOST=fiado-pro-db
DB_PORT=5432
DB_NAME=fiado_pro
DB_USER=fiado_user
DB_PASSWORD=change_me_in_production

# OpenRouter (IA — toda chamada passa pelo backend, nunca no bundle do frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Admin bootstrap (frente CORE) — usado também pelo fallback provisório de
# requireAdmin enquanto users.role (migration 002) não estiver disponível.
ADMIN_EMAIL=

# JWT Auth
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://fiadopro.jcplanejamento.com.br,http://localhost:3000

# Logs
LOG_LEVEL=info

# Asaas (Billing) — staging roda sem essas variaveis (pagamentos ficam desabilitados)
# O Pro custa R$ 30,00. A fonte é o código do servidor. Esta linha só documenta.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_PRO_PRICE=30.00
