# =================================================================
# Fiado Pro — Raiz — Variaveis de ambiente para docker-compose
# Copie este arquivo para .env e preencha os valores
# =================================================================

# Senha do role fiado_user (bootstrap/migrations/manutenção)
DB_PASSWORD=
# Senha separada do role de runtime fiado_app; preencher para DB_USER=fiado_app
DB_APP_PASSWORD=
# Opcional: override temporário para cutover/rollback (fiado_app por padrão)
DB_USER=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
RESEND_API_KEY=
ADMIN_EMAIL=
OPENROUTER_API_KEY=
