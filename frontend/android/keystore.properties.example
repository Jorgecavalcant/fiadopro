# Copie este arquivo para "keystore.properties" (NA MESMA PASTA: frontend/android/)
# e preencha com os dados do seu keystore. NUNCA versione o keystore.properties real.
#
# storeFile: caminho do .jks. Relativo a frontend/android/app/ OU caminho absoluto.
#   Recomendado: colocar o fiado-pro-release.jks em frontend/android/app/
storeFile=fiado-pro-release.jks
storePassword=COLOQUE_A_SENHA_DO_KEYSTORE
keyAlias=fiadopro-release
keyPassword=COLOQUE_A_SENHA_DA_CHAVE
